<Project Sdk="Microsoft.NET.Sdk">
  <!-- Separate process for coach notifications, so the recorder never depends on the coach. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(LifeReplayWinTfm)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LifeReplay.CoachTray</AssemblyName>
    <RootNamespace>LifeReplay.CoachTray</RootNamespace>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LifeReplay.Coach\LifeReplay.Coach.csproj" />
  </ItemGroup>
</Project>
