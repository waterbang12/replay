<Window x:Class="LifeReplay.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LifeReplay.Viewer"
        Title="LifeReplay Replay" Width="1400" Height="900" MinWidth="760" MinHeight="480" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Top bar: day selection, view, delete, status -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="PrevDayButton" Content="‹" ToolTip="Previous day with recordings" FontSize="16" Padding="8,0"/>
                    <DatePicker x:Name="DayPicker" Width="130" Margin="4,0" VerticalContentAlignment="Center"/>
                    <Button x:Name="NextDayButton" Content="›" ToolTip="Next day with recordings" FontSize="16" Padding="8,0"/>
                    <Button x:Name="TodayButton" Content="Today" Margin="6,0,0,0"/>
                    <ComboBox x:Name="DaysCombo" Width="230" Margin="10,0,0,0" ToolTip="Days that have recordings"/>
                    <TextBlock Text="Show" Margin="16,0,6,0" Foreground="{StaticResource Muted}"/>
                    <ComboBox x:Name="ViewCombo" Width="250"/>
                    <Button x:Name="RefreshButton" Content="Refresh" Margin="10,0,0,0" ToolTip="Reload recordings (F5)"/>
                    <ToggleButton x:Name="SummaryButton" Content="Summary" Margin="6,0,0,0" Padding="10,4" ToolTip="Time per app and tab for this day"/>
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="6,0,0,0">
                        <MenuItem x:Name="DeleteMenu" Header="Delete ▾" Foreground="{StaticResource Fg}" Padding="10,5"
                                  BorderBrush="{StaticResource Border}" BorderThickness="1" Background="#34343A">
                            <MenuItem x:Name="DeleteSegmentItem" Header="Delete the segment(s) at the playhead…" Foreground="#111114"/>
                            <MenuItem x:Name="DeleteSessionItem" Header="Delete the recording session at the playhead…" Foreground="#111114"/>
                            <Separator/>
                            <MenuItem x:Name="DeleteDayItem" Header="Delete this entire day…" Foreground="#111114"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
            </DockPanel>
        </Border>

        <!-- Bottom: timeline and transport controls -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <StackPanel>
                <local:TimelineControl x:Name="Timeline" Height="150" Margin="0,4,0,0"/>
                <DockPanel Margin="10,6,10,10" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="PrevSegButton" Content="⏮" ToolTip="Previous recording (PgUp)"/>
                        <Button x:Name="Back60Button" Content="−1m" ToolTip="Back 1 minute (Shift+←)"/>
                        <Button x:Name="Back10Button" Content="−10s" ToolTip="Back 10 seconds (←)"/>
                        <Button x:Name="PlayButton" Content="▶  Play" MinWidth="90" FontWeight="SemiBold" ToolTip="Play / pause (Space)"/>
                        <Button x:Name="Fwd10Button" Content="+10s" ToolTip="Forward 10 seconds (→)"/>
                        <Button x:Name="Fwd60Button" Content="+1m" ToolTip="Forward 1 minute (Shift+→)"/>
                        <Button x:Name="NextSegButton" Content="⏭" ToolTip="Next recording (PgDn)"/>
                        <TextBlock Text="Speed" Margin="16,0,6,0" Foreground="{StaticResource Muted}"/>
                        <ComboBox x:Name="SpeedCombo" Width="70" ToolTip="Playback speed (↑ / ↓)"/>
                        <CheckBox x:Name="SkipInactiveCheck" Content="Skip inactive periods" ToolTip="Jump over stretches where nothing changed on screen"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="Jump to" Margin="0,0,6,0" Foreground="{StaticResource Muted}"/>
                        <TextBox x:Name="JumpBox" Width="90" ToolTip="Local time, e.g. 14:30 or 2:30 PM or 14:30:15"/>
                        <Button x:Name="JumpButton" Content="Go"/>
                        <TextBlock x:Name="TimeText" FontSize="20" FontWeight="SemiBold" Margin="16,0,0,0" FontFamily="Consolas" Text="--:--:--"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Time per app / tab (window-title log) -->
        <Border x:Name="SummaryPanel" DockPanel.Dock="Right" Width="400" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,12,14,6">
                    <TextBlock x:Name="SummaryTitle" FontSize="15" FontWeight="SemiBold" Text="Time per app"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <RadioButton x:Name="ModeApps" Content="Apps" IsChecked="True" GroupName="SummaryMode" Padding="12,4" Margin="0,0,4,0"/>
                        <RadioButton x:Name="ModeTopics" Content="Topics" GroupName="SummaryMode" Padding="12,4" Margin="0,0,4,0"/>
                        <RadioButton x:Name="ModePlan" Content="Plan" GroupName="SummaryMode" Padding="12,4" Margin="0,0,4,0"/>
                        <RadioButton x:Name="ModePhone" Content="iPhone" GroupName="SummaryMode" Padding="12,4"/>
                    </StackPanel>
                    <TextBlock x:Name="SummarySubtitle" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0,14,14">
                    <StackPanel x:Name="SummaryList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Video area -->
        <Grid Background="Black">
            <UniformGrid x:Name="VideoGrid"/>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                       Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600"/>
            <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Background="#CC202024"
                    CornerRadius="6" Padding="12,6" Visibility="Collapsed">
                <TextBlock x:Name="ToastText"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
